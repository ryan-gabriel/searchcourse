# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Site / App URL
NEXT_PUBLIC_APP_URL=https://searchcourse.vercel.app

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RapidAPI (Udemy Coupon Feed - paginated, 10 items/page, stops on a short page)
# Example endpoint: https://paid-udemy-course-for-free.p.rapidapi.com/?page=0
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=your-feed-host.p.rapidapi.com
RAPIDAPI_PATH=/            # defaults to "/" if not set
RAPIDAPI_MAX_PAGES=1        # 1 page (10 courses) per run; feed list is trusted as-is

# Affiliate Links (Impact.com deep-link prefix - must be YOUR trk/imp tracking base)
# Format: https://trk.udemy.com/c/{campaignId}/{affiliateId}/{clickId}
# Get it from Impact Dashboard -> Track -> Deep Links
IMPACT_AFFILIATE_BASE=https://trk.udemy.com/c/YOUR_CAMPAIGN_ID/YOUR_AFFILIATE_ID/YOUR_CLICK_ID

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Site
SITE_BASE_URL=https://searchcourse.vercel.app

# Cron jobs (cron-job.org auth secret - protects /api/jobs/* endpoints)
CRON_SECRET=your-random-cron-secret-here

# Rate limiting (optional)
RATE_LIMIT_SEARCH=30
RATE_LIMIT_CLICK=60

# IP hashing salt (optional)
IP_SALT=change-me
