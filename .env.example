# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Site / App URL
NEXT_PUBLIC_APP_URL=https://searchcourse.com

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RapidAPI (Udemy Coupon Feed - paginated, 10 items/page, stops on a short page)
# Example endpoint: https://paid-udemy-course-for-free.p.rapidapi.com/?page=0
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=your-feed-host.p.rapidapi.com
RAPIDAPI_PATH=/            # defaults to "/" if not set
RAPIDAPI_MAX_PAGES=25      # 25 pages (250 courses) per run = ~75 req/day at 3 syncs

# Affiliate Links (Impact.com deep-link prefix - must be YOUR trk/imp tracking base)
# Format: https://trk.udemy.com/c/{campaignId}/{affiliateId}/{clickId}
# Get it from Impact Dashboard -> Track -> Deep Links
IMPACT_AFFILIATE_BASE=https://trk.udemy.com/c/YOUR_CAMPAIGN_ID/YOUR_AFFILIATE_ID/YOUR_CLICK_ID

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Site
SITE_BASE_URL=https://searchcourse.com

# Rate limiting (optional)
RATE_LIMIT_SEARCH=30
RATE_LIMIT_CLICK=60

# IP hashing salt (optional)
IP_SALT=change-me

# Coupon Verification (optional; used by cleanup + check-coupon)
# Coupons are live-checked against Udemy in a real browser. Since Udemy blocks
# plain HTTP requests, a Playwright browser is required.
VERIFY_MAX_COUPONS=50          # coupons checked per cleanup run (oldest-verified first)
VERIFY_TIMEOUT_MS=25000        # per-coupon page load timeout
VERIFY_RATE_LIMIT_MS=500       # delay between coupon navigations
VERIFY_HEADLESS=true           # set to false to watch the browser locally
VERIFY_BROWSER_CHANNEL=chrome  # "chrome" on desktop; "none" to force bundled Playwright Chromium (CI)
