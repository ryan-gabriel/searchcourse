# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Site / App URL
NEXT_PUBLIC_APP_URL=https://searchcourse.vercel.app

# Public Telegram channel invite link (used by site CTAs + broadcast footer)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/searchcourses

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Affiliate Links (Impact.com deep-link prefix - must be YOUR trk/imp tracking base)
# Format: https://trk.udemy.com/c/{campaignId}/{affiliateId}/{clickId}
# Get it from Impact Dashboard -> Track -> Deep Links
IMPACT_AFFILIATE_BASE=https://trk.udemy.com/c/YOUR_CAMPAIGN_ID/YOUR_AFFILIATE_ID/YOUR_CLICK_ID

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Site
SITE_BASE_URL=https://searchcourse.vercel.app

# Cron jobs (cron-job.org auth secret - protects /api/jobs/* endpoints)
CRON_SECRET=your-random-cron-secret-here

# Coupon scraper tuning (optional). Suggest hourly scrape, small batch:
SCRAPE_ENABLED_SOURCES=discudemy,tutorialbar
SCRAPE_MAX_PAGES=2
SCRAPE_MAX_POSTS=6
SCRAPE_SLEEP_MS=300
# SCRAPE_DRY_RUN=1   # uncomment to log parsed items without writing to the DB

# Telegram broadcast tuning (optional). Suggest hourly broadcast with a
# 12h expiry guard; coupons unverified for >12h are skipped as likely dead:
BROADCAST_MIN_EXPIRY_HOURS=12
BROADCAST_MAX_VERIFIED_AGE_HOURS=12

# Rate limiting (optional)
RATE_LIMIT_SEARCH=30
RATE_LIMIT_CLICK=60

# IP hashing salt (optional)
IP_SALT=change-me
